{
  "expo": {
    "name": "Abacus",
    "slug": "abacus_app",
    "version": "2.2.1",
    "orientation": "portrait",
    "icon": "./assets/img/Sprouting_Minds_Abacus_(1).png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karman.spa.ios",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This identifier will be used to show you personalized ads.",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          }
        ]
      }
    },
    "android": {
      "package": "com.karman.spa",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/Sprouting_Minds_Abacus_(1).png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/img/Sprouting_Minds_Abacus_(1).png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7069180478740738~1025649939",
          "android_app_id": "ca-app-pub-7069180478740738~1025649939",
          "iosAppId": "ca-app-pub-7069180478740738~1025649939",
          "ios_app_id": "ca-app-pub-7069180478740738~1025649939",
          "userTrackingUsageDescription": "This identifier will be used to show you personalized ads.",
          "facebookMediation": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/img/Sprouting_Minds_Abacus_(1).png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7e852fbf-1296-416e-846a-93f1c6f9326b"
      }
    }
  }
}