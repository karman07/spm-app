{
  "expo": {
    "name": "Abacus",
    "slug": "abacus_app",
    "version": "2.2.1",
    "orientation": "portrait",
    "icon": "./assets/img/icon-1024.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karman.spa.ios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.karman.spa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/img/Sprouting_Minds_Abacus_(1).png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/img/Sprouting_Minds_Abacus_(1).png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7e852fbf-1296-416e-846a-93f1c6f9326b"
      }
    }
  }
}
